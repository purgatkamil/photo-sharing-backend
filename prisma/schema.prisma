generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Table {
  id        Int        @id @default(autoincrement())
  name      String
  token     String     @unique // trafi do QR
  createdAt DateTime   @default(now())
  uploads   Upload[]
  eventLogs EventLog[]
}

model Upload {
  id           Int      @id @default(autoincrement())
  table        Table    @relation(fields: [tableId], references: [id])
  tableId      Int
  originalName String
  storedName   String // nazwa pliku na dysku
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  createdAt    DateTime @default(now())
}

model EventLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  table     Table?   @relation(fields: [tableId], references: [id])
  tableId   Int?
  type      String // np. "upload_saved", "upload_error"
  data      Json // szczegóły zdarzenia w JSON
}
